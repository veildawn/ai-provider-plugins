{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/veildawn/ai-provider-plugins/main/schemas/manifest-v3.schema.json",
  "title": "AI Proxy integration Manifest v3",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "id", "type", "version", "name", "description", "publisher", "signature", "provides"],
  "properties": {
    "manifest_version": {"const": 3},
    "id": {"$ref": "#/$defs/slug"},
    "type": {"const": "integration"},
    "version": {"type": "string", "minLength": 1},
    "name": {"$ref": "#/$defs/text"},
    "description": {"$ref": "#/$defs/text"},
    "homepage": {"type": "string", "format": "uri"},
    "author": {"type": "string"},
    "publisher": {"$ref": "#/$defs/slug"},
    "min_app_version": {"type": "string"},
    "docs": {"$ref": "#/$defs/text"},
    "icon": {"type": "string", "pattern": "^data:image/(png|jpeg|webp);base64,"},
    "signature": {"$ref": "#/$defs/signature"},
    "depends": {"type": "array", "maxItems": 8, "items": {"$ref": "#/$defs/dependency"}},
    "provides": {"$ref": "#/$defs/provides"},
    "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}}
  },
  "$defs": {
    "slug": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"},
    "text": {
      "type": "object",
      "minProperties": 1,
      "required": ["en"],
      "propertyNames": {"pattern": "^[A-Za-z]{2,3}(-[A-Za-z0-9]+)*$"},
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "signature": {
      "type": "object",
      "additionalProperties": false,
      "required": ["alg", "key_id", "sig"],
      "properties": {
        "alg": {"const": "ed25519"},
        "key_id": {"type": "string", "pattern": "^ed25519:[0-9a-f]{16}$"},
        "sig": {"type": "string", "pattern": "^[A-Za-z0-9+/]{86}==$"}
      }
    },
    "dependency": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {"id": {"$ref": "#/$defs/slug"}, "range": {"type": "string"}}
    },
    "provides": {
      "type": "object",
      "additionalProperties": false,
      "required": ["providers"],
      "properties": {
        "providers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/provider"}},
        "model_facts": {"type": "array", "items": {"type": "object"}},
        "model_pools": {"type": "array", "items": {"type": "object"}},
        "plans": {"type": "array", "items": {"type": "object"}}
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "base_url"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9_-]*$"},
        "display_name": {"type": "string"},
        "kind": {"enum": ["custom", "aiproxy"]},
        "transport": {"enum": ["cosy", "cosy-intl", "keycloak", "kimi-code", "codewhisperer", "cursor-rpc", "gemini-v1internal", "gemini-aistudio", "openai-oai", "anthropic-oai", "xai-oai"]},
        "module": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "http": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^(\\*\\.)?[A-Za-z0-9.-]+$"}},
        "protocols": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["openai", "anthropic", "responses"]}},
        "base_url": {"type": "string", "format": "uri", "pattern": "^https?://"},
        "protocol_bases": {"type": "object", "additionalProperties": {"$ref": "#/$defs/protocol_base"}},
        "operation_url": {"type": "boolean"},
        "family": {"enum": ["openai", "anthropic", "responses"]},
        "route_prefix": {"type": "string", "pattern": "^[a-z0-9_-]*$"},
        "headers": {"type": "object", "additionalProperties": {"type": "string"}},
        "icon": {"type": "string"},
        "cloudflare_tls": {"type": "boolean"},
        "pooled_upstream": {"type": "boolean"},
        "quota_on_402": {"type": "boolean"},
        "count_tokens_upstream": {"type": "boolean"},
        "auto_official_pricing": {"type": "boolean"},
        "quota_query": {},
        "prompt": {"$ref": "#/$defs/prompt"},
        "models": {"type": "array", "items": {"$ref": "#/$defs/model"}}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "runtime", "data", "sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$"},
        "runtime": {"const": "wasm@1"},
        "data": {"type": "string", "contentEncoding": "base64", "maxLength": 11184812},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "protocol_base": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base_url"],
      "properties": {"base_url": {"type": "string", "format": "uri"}, "operation_url": {"type": "boolean"}}
    },
    "prompt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["system_replace"],
      "properties": {"system_replace": {"type": "array", "minItems": 1, "maxItems": 10, "items": {"$ref": "#/$defs/replacement"}}}
    },
    "replacement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["find", "replace"],
      "properties": {"find": {"type": "string", "minLength": 1}, "replace": {"type": "string"}, "note": {"type": "string"}}
    },
    "model": {
      "oneOf": [
        {"type": "string", "minLength": 1},
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["id"],
          "properties": {
            "id": {"type": "string", "minLength": 1},
            "context_window": {"type": "integer", "minimum": 1},
            "prompt_per_1m": {"type": "number", "minimum": 0},
            "completion_per_1m": {"type": "number", "minimum": 0},
            "cache_read_per_1m": {"type": "number", "minimum": 0},
            "cache_write_per_1m": {"type": "number", "minimum": 0}
          }
        }
      ]
    }
  }
}
