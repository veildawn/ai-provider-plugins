{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "AI Proxy provider marketplace index v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "plugins"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "plugins": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "text": {
      "type": "object",
      "required": [
        "en"
      ],
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "version",
        "type",
        "name",
        "description",
        "provider_name",
        "protocols",
        "capabilities",
        "publisher"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "version": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "const": "integration"
        },
        "name": {
          "$ref": "#/$defs/text"
        },
        "description": {
          "$ref": "#/$defs/text"
        },
        "tags": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "provider_name": {
          "type": "string",
          "minLength": 1
        },
        "protocols": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "openai",
              "anthropic",
              "responses",
              "realtime"
            ]
          }
        },
        "capabilities": {
          "type": "array",
          "contains": {
            "const": "provider"
          },
          "items": {
            "type": "string"
          }
        },
        "icon": {
          "type": "string"
        },
        "homepage": {
          "type": "string",
          "format": "uri"
        },
        "author": {
          "type": "string"
        },
        "publisher": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]{0,63}$"
        },
        "key_id": {
          "type": "string",
          "pattern": "^ed25519:[0-9a-f]{16}$"
        },
        "min_app_version": {
          "type": "string"
        },
        "updated_at": {
          "type": "string",
          "format": "date"
        },
        "module_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "module_bytes": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
