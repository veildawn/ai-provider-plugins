{
  "author": "veildawn",
  "description": {
    "en": "Uses your own Antigravity CLI through acp-bridge. On a non-Docker gateway host, enabling this plugin automatically runs and stops the local bridge once agy and acp-bridge are installed, and you can log agy in from the environment panel. The login stays in the CLI and only the bridge key reaches the gateway. Single-tenant: everyone who can reach this account shares one Antigravity identity and one local home, so restrict it to one person's plan. Tools run one at a time; sampling parameters and replayed images are lost, and an image or document in a new message is refused.",
    "zh": "通过 acp-bridge 使用你自己的 Antigravity CLI。在非 Docker 网关主机上，装好 agy 和 acp-bridge 后启用本插件会自动运行本机 bridge、停用时自动关闭，并可在环境检查面板直接引导 agy 登录。登录态留在 CLI，网关只保存 bridge 密钥。仅限单租户：能用到这个账号的人共用同一个 Antigravity 身份和本地目录，请只把它分配给一个人的套餐。工具逐个执行，采样参数和重放中的图片不生效，新消息里的图片或文档会被拒绝。"
  },
  "homepage": "https://antigravity.google",
  "icon": "data:image/png;base64,",
  "id": "antigravity-acp",
  "manifest_version": 3,
  "min_app_version": "0.50.3",
  "name": {
    "en": "Antigravity ACP",
    "zh": "Antigravity 本机桥"
  },
  "provides": {
    "account": {
      "description": {
        "en": "Leave the key blank when connecting to the gateway-managed local acp-bridge (the gateway binds its managed key automatically). Paste ACP_BRIDGE_KEY only when connecting to an external bridge. Add one account per bridge, and limit it to one person's plan.",
        "zh": "连接网关自动托管的本机 acp-bridge 时留空密钥即可（网关会自动关联本机密钥）；仅在连接外部主机上的 bridge 时粘贴共享密钥（ACP_BRIDGE_KEY）。一个 bridge 只加一个账号，并只分配给一个人的套餐。"
      },
      "fields": [
        {
          "help_text": {
            "en": "Leave blank to bind the gateway's local managed acp-bridge key automatically, or paste ACP_BRIDGE_KEY for a remote/self-managed bridge.",
            "zh": "使用网关自动托管的本机 acp-bridge 时留空即可自动绑定密钥；连接远程或自管 bridge 时再粘贴 ACP_BRIDGE_KEY。"
          },
          "label": {
            "en": "Bridge key (optional for local managed bridge)",
            "zh": "Bridge 密钥（本机自动托管可留空）"
          },
          "name": "api_key",
          "type": "password"
        }
      ],
      "flow": "form",
      "title": {
        "en": "Connect acp-bridge",
        "zh": "连接 acp-bridge"
      }
    },
    "providers": [
      {
        "base_url": "http://127.0.0.1:8787",
        "cache_affinity": true,
        "display_name": "Antigravity ACP",
        "models": [
          "claude-opus-5-5-low",
          "claude-opus-5-5-medium",
          "claude-opus-5-5-high",
          "gemini-4-argon-low",
          "gemini-4-argon-medium",
          "gemini-4-argon-high",
          "gpt-oss-120b-medium"
        ],
        "name": "antigravity-acp",
        "protocols": [
          "anthropic"
        ]
      }
    ]
  },
  "publisher": "veildawn",
  "requires": [
    {
      "detect": {
        "args": [
          "--version"
        ],
        "command": "agy",
        "pattern": "^(\\d+\\.\\d+\\.\\d+)"
      },
      "homepage": "https://antigravity.google/docs/getting-started?tab=cli",
      "id": "agy",
      "install": [
        {
          "archive": "tar.gz",
          "checksum": "sha512",
          "download_hosts": [
            "https://storage.googleapis.com/antigravity-public/"
          ],
          "manifest_url": "https://antigravity-cli-auto-updater-974169037036.us-central1.run.app/manifests/{platform}.json",
          "member": "antigravity",
          "method": "release_manifest",
          "os": [
            "darwin",
            "linux"
          ],
          "platforms": {
            "darwin_amd64": "darwin_amd64",
            "darwin_arm64": "darwin_arm64",
            "linux_amd64": "linux_amd64",
            "linux_amd64_musl": "linux_amd64_musl",
            "linux_arm64": "linux_arm64",
            "linux_arm64_musl": "linux_arm64_musl"
          },
          "target": "~/.local/bin/agy"
        }
      ],
      "name": {
        "en": "Antigravity CLI",
        "zh": "Antigravity CLI"
      },
      "probes": [
        {
          "args": [
            "help",
            "acp"
          ],
          "expect": [
            "--gemini-dir",
            "--app-data-dir",
            "--agent",
            "--process-per-session",
            "--disable-telemetry",
            "--log-file",
            "--sandbox",
            "--include-default-customizations"
          ]
        }
      ],
      "range": ">=1.5.3 <1.6.0"
    },
    {
      "detect": {
        "args": [
          "version"
        ],
        "command": "acp-bridge",
        "pattern": "^acp-bridge (\\d+\\.\\d+\\.\\d+)"
      },
      "homepage": "https://github.com/veildawn/ai-provider-plugins/releases",
      "id": "acp-bridge-cli",
      "install": [
        {
          "archive": "tar.gz",
          "checksum": "sha512",
          "download_hosts": [
            "https://raw.githubusercontent.com/veildawn/ai-provider-plugins/main/releases/acp-bridge/"
          ],
          "manifest_url": "https://raw.githubusercontent.com/veildawn/ai-provider-plugins/main/releases/acp-bridge/{platform}.json",
          "member": "acp-bridge",
          "method": "release_manifest",
          "os": [
            "darwin",
            "linux"
          ],
          "platforms": {
            "darwin_amd64": "darwin_amd64",
            "darwin_arm64": "darwin_arm64",
            "linux_amd64": "linux_amd64",
            "linux_amd64_musl": "linux_amd64",
            "linux_arm64": "linux_arm64",
            "linux_arm64_musl": "linux_arm64"
          },
          "target": "~/.local/bin/acp-bridge"
        }
      ],
      "name": {
        "en": "ACP Bridge CLI",
        "zh": "ACP 本机桥程序"
      },
      "probes": [
        {
          "args": [
            "serve",
            "--help"
          ],
          "expect": [
            "-key-file",
            "-listen",
            "-agy",
            "-home"
          ]
        }
      ],
      "range": ">=0.1.1"
    },
    {
      "detect": {
        "field": "bridge_version",
        "from": "provider_health",
        "path": "/healthz",
        "provider": "antigravity-acp"
      },
      "id": "acp-bridge",
      "name": {
        "en": "ACP Bridge Service",
        "zh": "ACP 本机桥服务"
      },
      "range": ">=0.1.1",
      "where": "provider"
    }
  ],
  "signature": {
    "alg": "ed25519",
    "key_id": "ed25519:a2b36ebc3a600442",
    "sig": "UwFmdpwG1razjhnLwHA//YRoTZ3dO88VyJYQJhvMeMZ1vSdK2fwVZ5HFfTi6blzDJEVw4a1mU9IgyQ29ZX5MDQ=="
  },
  "type": "integration",
  "version": "0.1.4"
}
