{
  "author": "veildawn",
  "description": {
    "en": "Alibaba Cloud Model Studio (DashScope) official OpenAI-compatible API with account model discovery.",
    "zh": "阿里云百炼（DashScope）官方 OpenAI 兼容 API，含账号模型发现。"
  },
  "homepage": "https://bailian.console.aliyun.com",
  "icon": "data:image/png;base64,",
  "id": "dashscope",
  "manifest_version": 3,
  "min_app_version": "0.17.18",
  "name": {
    "en": "DashScope",
    "zh": "阿里云百炼"
  },
  "provides": {
    "account": {
      "description": {
        "en": "Paste a DashScope API key. Models are discovered from your account.",
        "zh": "粘贴百炼 API Key；模型将从你的账号自动发现。"
      },
      "fields": [
        {
          "label": {
            "en": "API key",
            "zh": "API Key"
          },
          "name": "api_key",
          "placeholder": "sk-...",
          "required": true,
          "type": "password"
        }
      ],
      "flow": "form",
      "guide_url": "https://bailian.console.aliyun.com/?tab=model#/api-key",
      "title": {
        "en": "Connect DashScope",
        "zh": "连接阿里云百炼"
      }
    },
    "providers": [
      {
        "base_url": "https://dashscope.aliyuncs.com/compatible-mode/v1",
        "display_name": "DashScope",
        "family": "openai",
        "name": "dashscope",
        "operation_url": true,
        "protocols": [
          "openai"
        ]
      }
    ]
  },
  "publisher": "veildawn",
  "signature": {
    "alg": "ed25519",
    "key_id": "ed25519:a2b36ebc3a600442",
    "sig": "dGQuwd6Bh4LjtCjLVKqAzxVs8xcuq4ulxLqrl3GIUc/P2zMHVwDJp5U8b7tJ4+AzHGrInk2bu4EjP/SRaynXBQ=="
  },
  "type": "integration",
