{
  "author": "veildawn",
  "description": {
    "en": "Groq's low-latency OpenAI and Responses APIs with account model discovery.",
    "zh": "Groq 的低延迟 OpenAI 与 Responses API，含账号模型发现。"
  },
  "homepage": "https://groq.com",
  "icon": "data:image/png;base64,",
  "id": "groq",
  "manifest_version": 3,
  "min_app_version": "0.17.18",
  "name": {
    "en": "Groq",
    "zh": "Groq"
  },
  "provides": {
    "account": {
      "description": {
        "en": "Paste a Groq API key. Models are discovered from your account.",
        "zh": "粘贴 Groq API Key；模型将从你的账号自动发现。"
      },
      "fields": [
        {
          "label": {
            "en": "API key",
            "zh": "API Key"
          },
          "name": "api_key",
          "placeholder": "gsk_...",
          "required": true,
          "type": "password"
        }
      ],
      "flow": "form",
      "guide_url": "https://console.groq.com/keys",
      "title": {
        "en": "Connect Groq",
        "zh": "连接 Groq"
      }
    },
    "providers": [
      {
        "base_url": "https://api.groq.com/openai/v1",
        "display_name": "Groq",
        "family": "openai",
        "name": "groq",
        "operation_url": true,
        "protocols": [
          "openai",
          "responses"
        ]
      }
    ]
  },
  "publisher": "veildawn",
  "signature": {
    "alg": "ed25519",
    "key_id": "ed25519:a2b36ebc3a600442",
    "sig": "/Gj1vZNzjofA9kcAEPGtTLS1jYe7ieELwM39MFJiuUdEJNVkQfOcjVuN+Q1BeNUWh/4P22wkLyfb4ndt256WCg=="
  },
  "type": "integration",
  "version": "1.0.5"
}
