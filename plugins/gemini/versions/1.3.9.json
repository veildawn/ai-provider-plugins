{
  "author": "veildawn",
  "description": {
    "en": "Google Gemini API (AI Studio) over the native generateContent protocol, with account model discovery and gateway translation for OpenAI Chat, Anthropic Messages, Responses, and Images.",
    "zh": "Google Gemini API（AI Studio）：声明原生 gemini（generateContent）协议，支持账号模型自动发现，并由网关提供 OpenAI Chat、Anthropic Messages、Responses 与生图互转。"
  },
  "homepage": "https://aistudio.google.com",
  "icon": "data:image/png;base64,",
  "id": "gemini",
  "manifest_version": 3,
  "min_app_version": "0.38.3",
  "name": {
    "en": "Gemini API"
  },
  "provides": {
    "account": {
      "description": {
        "en": "Paste a Gemini API key from Google AI Studio. Models are discovered from your account.",
        "zh": "粘贴 Google AI Studio 的 Gemini API Key；模型将从你的账号自动发现。"
      },
      "fields": [
        {
          "label": {
            "en": "Gemini API key",
            "zh": "Gemini API Key"
          },
          "name": "api_key",
          "placeholder": "AIza...",
          "required": true,
          "type": "password"
        }
      ],
      "flow": "form",
      "guide_url": "https://aistudio.google.com/app/apikey",
      "import": {
        "aliases": [
          "aistudio",
          "google-ai-studio",
          "gemini-api",
          "generativelanguage"
        ]
      },
      "title": {
        "en": "Connect Gemini API",
        "zh": "连接 Gemini API"
      }
    },
    "providers": [
      {
        "base_url": "https://generativelanguage.googleapis.com/v1beta",
        "display_name": "Gemini API",
        "family": "gemini",
        "name": "gemini",
        "operation_url": true,
        "protocols": [
          "gemini"
        ]
      }
    ]
  },
  "publisher": "veildawn",
  "signature": {
    "alg": "ed25519",
    "key_id": "ed25519:a2b36ebc3a600442",
    "sig": "8WPqGOLwp5ubkgAThgc0vjwULXKAlSt6ycCp4XL9F0CiYC/Cy0bYTTMIpLgTd95g7KWxJD5gbBZ7eKdiLfKCDw=="
  },
  "type": "integration",
  "version": "1.3.9"
}
